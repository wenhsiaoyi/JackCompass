# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Gradle
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# Android Studio / IntelliJ
.idea/
*.iml

# Build output
build/
bin/

# Machine-specific SDK path — contains sdk.dir, never commit
local.properties

# Packaged artifacts
*.apk
*.aab
*.ap_
*.dex

# Native / capture output
.cxx/
.externalNativeBuild/
captures/

# OS noise
.DS_Store
Thumbs.db

# trail's local graph cache is gitignored by .trail/.gitignore (run `trail build`).

# Signing material — never commit. app/upload-keystore.jks is the Play App Signing
# upload key; keystore.properties holds its passwords. Both are machine-local.
*.jks
*.keystore
*.p12
keystore.properties

# 上架上傳腳本是本機工具（寫死機器本地的 service account 金鑰路徑），排除在版本外
docs/upload_to_play.py

# 驗證用的本機截圖（`_shots` 是 QA 過程、`_shots_store` 是商店圖的原始擷取）。
# 要進版控的是整理後的 docs/store-screenshots/。
_shots/
_shots_store/
