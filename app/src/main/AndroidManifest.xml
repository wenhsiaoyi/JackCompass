<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GPS: 於執行時再向使用者索取 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 指南針刻度震動 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      宣告為 required="false"：沒有這些感測器的裝置仍可安裝，
      只是對應畫面會顯示「此裝置不支援」。
    -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />

    <!--
      一定要明寫：只要有 ACCESS_FINE_LOCATION，AGP 就會自動補
      android.hardware.location required="true"，變成沒有定位硬體的裝置裝不上，
      「沒有 GPS 就不顯示經緯度」那條路徑永遠走不到。
    -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.JackCompass">

        <!-- UMP 4.0 只從 manifest 讀這個 key，Next-Gen 的 InitializationConfig 不會餵給它。
             實測少了這行：logcat 出現「UMP SDK requires a valid application ID」，
             同意表單永遠不出現，但 canRequestAds() 仍回 true、廣告照播——
             等於靜默地跳過同意政策，不會報錯。值跟著 ads.xml 走，
             debug 構型由 app/src/debug/res/values/ads.xml 覆寫成測試 ID。 -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- Analytics 預設關閉：FirebaseInitProvider 在 Application 建立時就初始化，
             不等 UMP 同意鏈。真正放行在 AdSession.finish() → AnalyticsConsent.apply()。
             少了這行，第一次啟動（表單還沒出現）就會開始收集。 -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />

        <!-- Analytics 只用來看彙總使用情形，不用於廣告：
             關掉廣告識別碼收集與廣告個人化訊號，隱私政策第五節的說法才成立。 -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <!-- API 32 以下：讓 appcompat 自動保存 App 內切換的語系（官方文件機制） -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.JackCompass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
